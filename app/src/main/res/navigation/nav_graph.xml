<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.mobileapppractice.presentation.auth.login.LoginFragment"
        android:label="Вход"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />

        <action
            android:id="@+id/action_loginFragment_to_forgotFragment"
            app:destination="@id/forgotFragment" />

    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.mobileapppractice.presentation.auth.register.RegisterFragment"
        android:label="Регистрация"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/forgotFragment"
        android:name="com.example.mobileapppractice.presentation.auth.forgot.ForgotFragment"
        android:label="Восстановление пароля"
        tools:layout="@layout/fragment_forgot" />

</navigation>